generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Source {
  BURGESS
  ZIZOO
  NAUTAL
  GLOBESAILOR
  CLICKANDBOAT
  YACHTWORLD
  BOAT24
  DREAM_YACHT
  SEVEN_STARS
  GLOBALCHARTER
}

enum ServiceType {
  CABIN_CHART
  FULL_CHARTER
  SALE
  DAY_CHART
}

enum BookingStatus {
  PENDING_CRYPTO
  AWAITING_CARD
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum YachtType {
  MOTOR_YACHT
  SAILING_YACHT
  GULLET
  CATAMARAN
  TRIMARAN
  SPEEDBOAT
  JET_SKI
  SAIL_BOAT
}

enum CharterType {
  BAREBOAT
  CREWED
  CABIN
  DAY
}

model Vessel {
  id              String      @id @default(cuid())
  type            ServiceType
  source          Source
  externalId      String
  
  title           String      @db.Text
  slug            String      @unique
  description     String      @db.Text
  shortDescription String?    @db.Text
  
  // Categorization
  yachtType       YachtType?
  charterType     CharterType?
  
  // Specs
  length          Float?      // in meters
  lengthFeet      Float?      // in feet
  beam            Float?
  draft           Float?
  year            Int?
  builder         String?
  model           String?
  refitYear       Int?
  
  engine          String?
  maxSpeed        Float?
  cruisingSpeed   Float?
  fuelCapacity    Float?
  waterCapacity   Float?
  
  cabins          Int?
  guestCabins     Int?
  beds            Int?
  bathrooms       Int?
  guests          Int       @default(0)
  crew            Int       @default(0)
  
  specs           Json?
  
  // Locations & Regions
  location        String?
  region          String?
  departurePort   String?
  arrivalPort     String?
  operatingAreas  String[]   // Where yacht typically operates
  destinations    String[]   // Available destinations
  
  // Features & Amenities
  features        String[]
  amenities       String[]
  waterToys       String[]
  entertainment   String[]
  
  // Media
  images          String[]
  videos          String[]
  virtualTourUrl  String?
  
  // Pricing
  basePrice       Decimal     @db.Decimal(12,2)
  currency        String      @default("EUR")
  pricePerWeek    Decimal?    @db.Decimal(12,2)
  pricePerDay     Decimal?    @db.Decimal(12,2)
  pricePlusExpenses Boolean   @default(false)
  
  // Availability
  availableFrom   DateTime?
  availableTo     DateTime?
  isAvailable     Boolean     @default(true)
  
  // URL & Meta
  urlOriginal     String
  lastChecked     DateTime    @default(now())
  
  metaTitle       String?
  metaDescription String?
  
  // Search/Filter fields (denormalized for performance)
  searchVector    String?     // For full-text search
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  departures      Departure[]
  bookings        Booking[]
  
  @@index([type, source])
  @@index([yachtType])
  @@index([charterType])
  @@index([region])
  @@index([location])
  @@index([departurePort])
  @@index([length])
  @@index([year])
  @@index([guests])
  @@index([cabins])
  @@index([basePrice])
  @@index([isAvailable])
  @@index([slug])
}

model Destination {
  id              String    @id @default(cuid())
  
  name            String
  slug            String    @unique
  country         String?
  region          String?
  continent       String?
  
  description     String?   @db.Text
  highlights      String[]
  
  image           String?
  
  departurePorts  String[]
  
  nearbyIslands   String[]
  
  bestTimeToVisit String[]
 avgTemperature  Float?
  
  latitude        Float?
  longitude       Float?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  vessels         Vessel[]
  departures      Departure[]
  
  @@index([region])
  @@index([country])
  @@index([continent])
}

model Departure {
  id              String    @id @default(cuid())
  vesselId        String
  vessel          Vessel    @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  destinationId   String?
  destination     Destination? @relation(fields: [destinationId], references: [id])
  
  externalId      String
  departureDate   DateTime
  arrivalDate     DateTime?
  
  departurePort   String?
  arrivalPort     String?
  route           String?
  itinerary       String?   @db.Text
  
  totalCabins     Int?
  availableCabins Int?
  status          String    @default("available")
  
  cabinPrices     Json?
  fullPrice       Decimal?  @db.Decimal(12,2)
  
  notes           String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  bookings        Booking[]
  
  @@index([vesselId, departureDate])
  @@index([departureDate])
  @@index([destinationId])
}

model SourceRule {
  id                String    @id @default(cuid())
  source            Source    @unique
  
  depositPercentage Decimal   @db.Decimal(5,2)
  paymentTiming     String
  requiresCard      Boolean   @default(true)
  
  cancellationPolicy String?  @db.Text
  termsUrl          String?
  formFields        Json?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Booking {
  id              String        @id @default(cuid())
  vesselId        String
  vessel          Vessel        @relation(fields: [vesselId], references: [id])
  departureId     String?
  departure       Departure?    @relation(fields: [departureId], references: [id])
  
  status          BookingStatus @default(PENDING_CRYPTO)
  
  depositAmount   Decimal       @db.Decimal(12,2)
  depositCurrency String        @default("USDT")
  cryptoTxHash    String?
  paidAt          DateTime?
  
  customerData    Json
  
  sourceBookingId String?
  sourceConfirmedAt DateTime?
  
  checkoutExpires  DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([status])
  @@index([checkoutExpires])
}

model SiteConfig {
  id              String    @id @default(cuid())
  
  siteName        String    @default("Neptune Marine")
  tagline         String?
  logoUrl         String?
  
  email           String?
  phone           String?
  whatsapp        String?
  
  instagram       String?
  facebook        String?
  youtube         String?
  
  cryptoGateway   String?
  walletAddress   String?
  
  maintenanceMode Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ScrapingLog {
  id              String    @id @default(cuid())
  source          Source
  vesselExternalId String?
  action          String
  status          String
  details         Json?
  errorMessage    String?
  
  createdAt       DateTime  @default(now())
  
  @@index([source, createdAt])
}

model Wallet {
  id              String    @id @default(cuid())
  
  chain           String    @db.Text // ETH, TRX, BTC, SOL, etc.
  address         String    @db.Text
  label           String?   @db.Text
  isActive        Boolean   @default(true)
  rotationIndex   Int       @default(0)
  
  totalReceived   Int       @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  status          String    @default("active") // active, pending, failed
  
  transactions    CryptoTransaction[]
  
  @@unique([chain, address])
  @@index([chain, isActive])
}

model CryptoTransaction {
  id              String    @id @default(cuid())
  walletId        String
  wallet          Wallet    @relation(fields: [walletId], references: [id])
  
  txHash          String    @unique
  fromAddress     String    @db.Text
  amount          String    @db.Text
  currency        String    // USDT, USDC, ETH, BTC, etc.
  chain           String
  
  status          String    @default("pending") // pending, confirmed, failed
  
  confirmations   Int       @default(0)
  blockNumber     Int?
  blockTimestamp  DateTime?
  
  bookingId       String?   @db.Text
  booking         Booking?  @relation(fields: [bookingId], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([walletId, status])
  @@index([bookingId])
}
